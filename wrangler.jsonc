{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-expense",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static web app built by Vite into dist/client. Unknown paths fall back to index.html.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "vars": {
    // Public origin used in magic-link emails. Empty means "use the origin of the request",
    // which works for workers.dev and custom domains alike.
    "APP_ORIGIN": "",
    // Inbound statement address is `${INBOUND_LOCAL_PART}+<household token>@${INBOUND_DOMAIN}`.
    "INBOUND_DOMAIN": "example.com",
    "INBOUND_LOCAL_PART": "stmt",
    // "log" prints outgoing mail to the console; "resend" sends through Resend (needs RESEND_API_KEY secret).
    "MAILER": "log",
    "MAIL_FROM": "Family Money <money@example.com>",
    // Raw statement emails are deleted from R2 after this many days.
    "RAW_MAIL_RETENTION_DAYS": "90"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-expense",
      "database_id": "eddba7ce-aa58-43c2-891e-7a6e1a075757",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "RAW_MAIL",
      "bucket_name": "personal-expense-mail"
    }
  ],

  // Optional: statement emails are processed right after they arrive (ctx.waitUntil) and the
  // nightly cron retries any that got stuck. To move parsing onto a queue instead (Workers Paid
  // plan, and a deploy token with Queues edit), uncomment this block; the code picks it up.
  // "queues": {
  //   "producers": [{ "binding": "PARSE_QUEUE", "queue": "personal-expense-parse" }],
  //   "consumers": [{ "queue": "personal-expense-parse", "max_batch_size": 5, "max_retries": 3 }]
  // },

  // Email Routing: route `stmt+*@yourdomain` to this Worker in the Cloudflare dashboard.

  "triggers": {
    // Nightly housekeeping at 03:10 UTC: recurring rules, insights, forecast (later phases), raw-mail retention.
    "crons": ["10 3 * * *"]
  },

  "observability": {
    "enabled": true
  }
}
