{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-expense",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // The app is served on its own subdomain; deploying creates the DNS record and certificate.
  // workers.dev stays on as a fallback address.
  "routes": [{ "pattern": "money.leadbase.stream", "custom_domain": true }],
  "workers_dev": true,

  // Static web app built by Vite into dist/client. Unknown paths fall back to index.html.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "vars": {
    // Public origin used in magic-link emails. Empty means "use the origin of the request",
    // which works for workers.dev and custom domains alike.
    "APP_ORIGIN": "",
    // Inbound statement address is `${INBOUND_LOCAL_PART}+<household token>@${INBOUND_DOMAIN}`.
    // Email Routing on leadbase.stream sends this mail to the Worker (catch-all, or a stmt@ rule
    // with subaddressing on). The Worker reads the token whatever the domain, so a subdomain
    // address keeps working if one is added later.
    "INBOUND_DOMAIN": "statements.leadbase.stream",
    "INBOUND_LOCAL_PART": "stmt",
    // How sign-in emails go out: "cloudflare" uses the send_email binding below, "resend" uses
    // Resend (RESEND_API_KEY secret), "log" only writes them to the Worker log (local development).
    "MAILER": "cloudflare",
    // Must be an address on a domain with Cloudflare Email Routing enabled.
    "MAIL_FROM": "Family Money <money@leadbase.stream>",
    // Raw statement emails are deleted from R2 after this many days.
    "RAW_MAIL_RETENTION_DAYS": "90"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-expense",
      "database_id": "eddba7ce-aa58-43c2-891e-7a6e1a075757",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "RAW_MAIL",
      "bucket_name": "personal-expense-mail"
    }
  ],

  // Optional: statement emails are processed right after they arrive (ctx.waitUntil) and the
  // nightly cron retries any that got stuck. To move parsing onto a queue instead (Workers Paid
  // plan, and a deploy token with Queues edit), uncomment this block; the code picks it up.
  // "queues": {
  //   "producers": [{ "binding": "PARSE_QUEUE", "queue": "personal-expense-parse" }],
  //   "consumers": [{ "queue": "personal-expense-parse", "max_batch_size": 5, "max_retries": 3 }]
  // },

  // Workers AI: reads statement emails the built-in readers cannot, and suggests categories for new
  // lines. Runs on Cloudflare's network under this account (free daily allowance, then per use);
  // a household can turn it off in Settings. Local development needs `wrangler login` for it, or
  // `wrangler dev --local`, which leaves it out: the app then carries on with its built-in readers.
  "ai": { "binding": "AI" },

  // Outgoing email through Cloudflare Email Service. On the Workers Free plan it delivers only to
  // addresses verified under Email Routing > Destination addresses (free). Onboarding the domain
  // for Email Sending (Workers Paid) lifts that restriction.
  "send_email": [{ "name": "EMAIL" }],

  // Email Routing: the leadbase.stream catch-all (or a stmt@leadbase.stream rule) sends mail to this Worker.

  "triggers": {
    // Nightly housekeeping at 03:10 UTC: recurring rules, insights, forecast (later phases), raw-mail retention.
    "crons": ["10 3 * * *"]
  },

  "observability": {
    "enabled": true
  }
}
