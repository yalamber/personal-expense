{
  "name": "personal-expense",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A money tracker for one family: statements in by email, insights and forecast out.",
  "scripts": {
    "dev": "concurrently -n web,worker -c cyan,magenta \"vite build --watch\" \"wrangler dev\"",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "lint": "npm run typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply personal-expense --local",
    "db:migrate:remote": "wrangler d1 migrations apply personal-expense --remote",
    "cf:types": "wrangler types",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "postal-mime": "^4.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  },
  "engines": {
    "node": ">=22"
  }
}
